# Copy to .env. Every value is optional — the backend runs with this file absent.
# Missing credentials degrade specific features and are reported at GET /api/health.

# --- Meeting I/O -------------------------------------------------------------------
# Without this, POST /api/meetings returns a `failed` meeting explaining how to use the
# fixture harness instead. Nothing crashes.
RECALL_API_KEY=
# Recall keys are REGION-SCOPED. A key from another region 401s on every call, which
# looks exactly like a bad key. Check this first when auth fails.
RECALL_REGION=us-west-2

# --- Reasoning ---------------------------------------------------------------------
# Drives both loops. With no key at all, the fixture harness replays its canned
# interjections instead of reasoning, so the frontend still has a full event stream.
# `auto` prefers Gemini, then Claude, then Tenstorrent. Force one with `gemini`,
# `claude`, `tenstorrent`, or `none`.
LLM_PROVIDER=auto

# Do NOT wrap the value in quotes — it is sent verbatim and 400s as an invalid key.
GEMINI_API_KEY=
# There is no `gemini-3.6-flash-lite`; 3.5 is the newest *lite*. Raise to
# `gemini-3.6-flash` if contradiction judgment is weak.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Qwen on Tenstorrent hardware, via an OpenAI-compatible endpoint. Flip
# LLM_PROVIDER=tenstorrent to use it instead of Gemini; the key alone will not — it sits
# last in the `auto` chain so it cannot silently take over.
TENSTORRENT_API_KEY=
TENSTORRENT_BASE_URL=https://console.tenstorrent.com/v1
# NOT Qwen3-VL-32B-Instruct. It is the newer model in the catalogue and it accepts
# `response_format` and then ignores it — HTTP 200, wrong shape, no error. Every call
# here is schema-constrained. Qwen3-32B enforces the schema.
TENSTORRENT_MODEL=Qwen/Qwen3-32B
TENSTORRENT_FAST_MODEL=Qwen/Qwen3-32B

# --- Voice -------------------------------------------------------------------------
# `auto` uses Inworld when INWORLD_API_KEY is set and falls back to sample clips.
# Force one with `inworld` or `sample`.
VOICE_PROVIDER=auto
INWORLD_API_KEY=
# Voice catalogue id. GET https://api.inworld.ai/tts/v1/voices lists them.
INWORLD_VOICE_ID=Dennis
INWORLD_MODEL_ID=inworld-tts-2

# --- Optional sponsors -------------------------------------------------------------
CHARACTERAI_API_KEY=

# --- Frontend ----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Live transcript (the wake word) -------------------------------------------------
# Recall pushes real-time transcript to this backend, so it needs a public https URL.
# In dev: ngrok http --url=<your-static-domain> 5000
# Without it the bot can speak but cannot hear, and "Hey AGI" never fires.
PUBLIC_BASE_URL=
# Shared secret appended to the webhook URL as ?token=. Change it.
RECALL_WEBHOOK_TOKEN=kindred-dev
# Silence after the last word before an utterance counts as finished. Recall streams
# transcript word-by-word; this is what turns that back into "someone stopped talking".
TRANSCRIPT_SILENCE_MS=1000
