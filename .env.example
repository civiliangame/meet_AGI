# Copy to .env. Every value is optional — the backend runs with this file absent.
# Missing credentials degrade specific features and are reported at GET /api/health.

# --- Meeting I/O -------------------------------------------------------------------
# Without this, POST /api/meetings returns a `failed` meeting explaining how to use the
# fixture harness instead. Nothing crashes.
RECALL_API_KEY=
# Recall keys are REGION-SCOPED. A key from another region 401s on every call, which
# looks exactly like a bad key. Check this first when auth fails.
RECALL_REGION=us-west-2

# --- Reasoning ---------------------------------------------------------------------
# Drives both loops. Without it the fixture harness replays its canned interjections
# instead of reasoning, so the frontend still has a full event stream to build against.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Triage runs on every utterance of every meeting, so it gets the cheap model.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- Voice -------------------------------------------------------------------------
# `auto` uses Inworld when INWORLD_API_KEY is set and falls back to sample clips.
# Force one with `inworld` or `sample`.
VOICE_PROVIDER=auto
INWORLD_API_KEY=
# Voice catalogue id. GET https://api.inworld.ai/tts/v1/voices lists them.
INWORLD_VOICE_ID=Dennis
INWORLD_MODEL_ID=inworld-tts-2

# --- Optional sponsors -------------------------------------------------------------
CHARACTERAI_API_KEY=
TENSTORRENT_ENDPOINT=

# --- Frontend ----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
